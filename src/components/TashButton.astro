---
import Icon from './Icon.astro';
import { href } from '../lib/site';

interface Props {
  url?: string;
  /** compact: שורה אחת בתוך כרטיס. ברירת מחדל: כרטיס שירות עם כפתור פעולה */
  compact?: boolean;
  label?: string;
}
const { url = 'https://tash.digital.idf.il/landing/', compact = false, label = 'כניסה לת״ש בטאץ׳' } = Astro.props;
const logo = href('/logos/tash-btouch-badge.png');
---
{compact ? (
  <a class="tash-row" href={url} target="_blank" rel="noopener">
    <img class="tb-logo" src={logo} alt="" width="44" height="44" decoding="async" />
    <span class="tb-tx"><strong>ת״ש בטאץ׳</strong><span>בקשות ומעקב במערכת הדיגיטלית</span></span>
    <span class="tb-go" aria-hidden="true"><Icon name="external" /></span>
    <span class="sr-only">{label}, נפתח בלשונית חדשה</span>
  </a>
) : (
  <div class="tash-card">
    <div class="tc-head">
      <img class="tb-logo" src={logo} alt="" width="56" height="56" decoding="async" />
      <div class="tb-tx"><strong>ת״ש בטאץ׳</strong><span>המערכת הדיגיטלית של צה״ל לבקשות ת״ש: הגשה, מסמכים ומעקב</span></div>
    </div>
    <a class="btn purple block" href={url} target="_blank" rel="noopener"><Icon name="external" />{label}</a>
  </div>
)}

---
import { href } from '../lib/site';
interface Props { size?: number }
const { size = 30 } = Astro.props;
const logos = [
  { n: 'ofek', alt: 'אופק' },
  { n: 'f108', alt: '108' },
  { n: 'lahav', alt: 'לה״ב' },
];
---
<span class="trio" style={`--sz:${size}px`} aria-hidden="true">
  {logos.map((l) => <img src={href(`/logos/${l.n}.png`)} alt="" width={size} height={size} />)}
</span>
<style>
  .trio { display: inline-flex; flex: none; }
  .trio img { width: var(--sz); height: var(--sz); border-radius: 50%; background: #fff; box-shadow: 0 0 0 2px #fff, 0 2px 6px rgb(16 43 112 / .2); }
  .trio img + img { margin-inline-start: calc(var(--sz) * -0.28); }
</style>

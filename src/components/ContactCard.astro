---
import Icon from './Icon.astro';
import { displayPhone, telHref, waHref } from '../lib/site';

interface Props {
  id: string;
  name: string;
  phone: string;
  whatsapp: 'yes' | 'no' | 'unknown';
  units?: string[];
  role?: string;
  hue?: 'a' | 'b' | 'c' | 'd';
}
const { id, name, phone, whatsapp, units = [], role, hue = 'a' } = Astro.props;
const sub = units.length > 0 ? units.join(' · ') : (role ?? '');
---
<div class="prow" id={`p-${id}`} data-person data-search={[name, ...units, role ?? ''].join(' ')}>
  <button
    class="row"
    type="button"
    data-open
    data-name={name}
    data-sub={sub}
    data-phone={phone}
    data-shown={displayPhone(phone)}
    data-tel={telHref(phone)}
    data-wa={whatsapp === 'no' ? '' : waHref(phone)}
    data-hue={hue}
  >
    <span class="avatar" data-h={hue} aria-hidden="true">{name.trim()[0]}</span>
    <span class="tx">
      <span class="t">{name}</span>
      {sub ? <span class="s">{sub}</span> : null}
    </span>
  </button>
  {whatsapp !== 'no' ? <a class="call wa" href={waHref(phone)} target="_blank" rel="noopener" aria-label={`וואטסאפ ל${name}`}><Icon name="whatsapp" /></a> : null}
  <a class="call" href={telHref(phone)} aria-label={`חיוג ל${name}`}><Icon name="phone" /></a>
</div>

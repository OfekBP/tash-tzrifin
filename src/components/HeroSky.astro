---
// שמיים, עננים ומבנה של שלושה מטוסים עם שובלים. וקטורי, קל ונקי.
---
<div class="sky-art" aria-hidden="true">
  <svg viewBox="0 0 375 210" preserveAspectRatio="xMidYMid slice">
    <defs>
      <linearGradient id="tr" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#fff" stop-opacity="0" />
        <stop offset=".7" stop-color="#fff" stop-opacity=".85" />
        <stop offset="1" stop-color="#fff" stop-opacity=".95" />
      </linearGradient>
      <filter id="blur"><feGaussianBlur stdDeviation="7" /></filter>
      <symbol id="jet" viewBox="-34 -24 68 48" overflow="visible">
        <path d="M10-2.4-12-21h-5L-8-2.8Z M10 2.4-12 21h-5L-8 2.8Z" fill="#3f63a3" />
        <path d="M-18-2.8-28-9h-3l5 6.2Z M-18 2.8-28 9h-3l5-6.2Z" fill="#3f63a3" />
        <path d="M28 0 14-2.2-6-2.6-24-3l-2 1.4v3.2L-24 3-6 2.6 14 2.2Z" fill="#6f90c6" />
        <ellipse cx="8" cy="0" rx="5.5" ry="1.5" fill="#cfe4ff" />
      </symbol>
    </defs>
    <g filter="url(#blur)" fill="#fff" opacity=".9">
      <ellipse cx="40" cy="190" rx="90" ry="26" />
      <ellipse cx="150" cy="205" rx="110" ry="24" />
      <ellipse cx="330" cy="195" rx="100" ry="28" />
      <ellipse cx="300" cy="40" rx="50" ry="12" opacity=".6" />
    </g>
    <g transform="translate(0 34)"><g stroke="url(#tr)" stroke-linecap="round" fill="none">
      <path d="M-10 118 130 62" stroke-width="3.2" />
      <path d="M-10 168 180 96" stroke-width="3.2" />
      <path d="M-10 70 80 30" stroke-width="3.2" />
    </g>
    <use href="#jet" x="94" y="22" width="52" height="36" transform="rotate(-22 120 40)" />
    <use href="#jet" x="152" y="62" width="52" height="36" transform="rotate(-22 178 80)" />
    <use href="#jet" x="58" y="-2" width="52" height="36" transform="rotate(-22 84 16)" /></g>
  </svg>
</div>

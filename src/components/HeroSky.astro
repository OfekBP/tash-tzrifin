---
// שלושה מטוסים בהרכב עם שובלים ועננים רכים, משולבים בשמיים של הכותרת (וקטורי, בלי מסגרת)
---
<div class="sky-art sky-l" aria-hidden="true">
  <svg viewBox="0 0 150 96" overflow="visible">
    <defs>
      <linearGradient id="hj-tr" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#fff" stop-opacity="0" />
        <stop offset=".6" stop-color="#fff" stop-opacity=".8" />
        <stop offset="1" stop-color="#fff" stop-opacity=".95" />
      </linearGradient>
      <radialGradient id="hj-cl">
        <stop offset="0" stop-color="#fff" stop-opacity=".95" />
        <stop offset=".6" stop-color="#fff" stop-opacity=".45" />
        <stop offset="1" stop-color="#fff" stop-opacity="0" />
      </radialGradient>
      <symbol id="hj-jet" viewBox="-34 -24 68 48" overflow="visible">
        <path d="M10-2.4-12-21h-5L-8-2.8Z M10 2.4-12 21h-5L-8 2.8Z" fill="#3f63a3" />
        <path d="M-18-2.8-28-9h-3l5 6.2Z M-18 2.8-28 9h-3l5-6.2Z" fill="#3f63a3" />
        <path d="M28 0 14-2.2-6-2.6-24-3l-2 1.4v3.2L-24 3-6 2.6 14 2.2Z" fill="#6f90c6" />
        <ellipse cx="8" cy="0" rx="5.5" ry="1.5" fill="#cfe4ff" />
      </symbol>
    </defs>
    <ellipse cx="38" cy="78" rx="52" ry="20" fill="url(#hj-cl)" />
    <ellipse cx="104" cy="88" rx="56" ry="18" fill="url(#hj-cl)" />
    <ellipse cx="128" cy="22" rx="30" ry="9" fill="url(#hj-cl)" opacity=".7" />
    <g stroke="url(#hj-tr)" stroke-linecap="round" fill="none" stroke-width="2.2">
      <path d="M-30 48 57 20" />
      <path d="M-20 91.5 91 55.5" />
    </g>
    <use href="#hj-jet" x="52" y="4" width="34" height="24" transform="rotate(-18 69 16)" />
    <use href="#hj-jet" x="86" y="38" width="38" height="27" transform="rotate(-18 105 51)" />
  </svg>
</div>
<div class="sky-art sky-r" aria-hidden="true">
  <svg viewBox="0 0 150 96" overflow="visible">
    <ellipse cx="60" cy="78" rx="50" ry="18" fill="url(#hj-cl)" />
    <ellipse cx="118" cy="26" rx="28" ry="9" fill="url(#hj-cl)" opacity=".7" />
    <path d="M-30 58.5 65 27.5" stroke="url(#hj-tr)" stroke-linecap="round" fill="none" stroke-width="2.2" />
    <use href="#hj-jet" x="60" y="10" width="38" height="27" transform="rotate(-18 79 23)" />
  </svg>
</div>

---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { href, SITE_NAME, SHOW_DRAFTS } from '../lib/site';
import Analytics from '@vercel/analytics/astro';
import heeboHe from '@fontsource-variable/heebo/files/heebo-hebrew-wght-normal.woff2?url';
import rubikHe from '@fontsource-variable/rubik/files/rubik-hebrew-wght-normal.woff2?url';

interface Props {
  title?: string;
  /** שורת הסבר מתחת לכותרת בראש העמוד */
  lead?: string;
  description?: string;
  /** חזרה: אם מוגדר מוצג חץ חזרה */
  back?: string;
  draft?: boolean;
  /** גוון השמיים של העמוד */
  tone?: 'sky' | 'lav';
  /** דף הבית: בלי ראש עמוד, הירו משלו */
  hero?: boolean;
}
const { title, lead, description = 'מרכז שירות לחיילי חובה בחיל האוויר בצריפין: זכויות, מדריכים ואנשי קשר בת״ש.', back, draft, tone = 'sky', hero = false } = Astro.props;
const fullTitle = title ? `${title} | ${SITE_NAME}` : SITE_NAME;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = (Astro.url.pathname.startsWith(base) ? Astro.url.pathname.slice(base.length) : Astro.url.pathname) || '/';
const onVercel = !!process.env.VERCEL;
const tabs = [
  { id: 'home', label: 'בית', url: '/', match: (p: string) => p === '/' || p.startsWith('/guide-me') || p.startsWith('/search') },
  { id: 'rights', label: 'זכויות', url: '/rights/', match: (p: string) => p.startsWith('/rights') },
  { id: 'guides', label: 'מדריכים', url: '/guides/', match: (p: string) => p.startsWith('/guides') || p.startsWith('/faq') || p.startsWith('/glossary') },
  { id: 'contacts', label: 'אנשי קשר', url: '/contacts/', match: (p: string) => p.startsWith('/contacts') },
];
---
<!doctype html>
<html lang="he" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content" />
    <meta name="color-scheme" content="light" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="he_IL" />
    <meta property="og:type" content="website" />
    {Astro.site ? <meta property="og:image" content={new URL(href('/og.png'), Astro.site).href} /> : null}
    <script is:inline>try{if(!sessionStorage.getItem('splash'))document.documentElement.classList.add('splash-on')}catch(e){}</script>
    <style is:inline set:html={`html.css-wait{background:#cde8fc}html.css-wait body{visibility:hidden}@font-face{font-family:'Rubik Fail';font-weight:300 900;font-display:swap;src:url(${rubikHe}) format('woff2')}@font-face{font-family:'Heebo Fail';font-weight:100 900;font-display:swap;src:url(${heeboHe}) format('woff2')}`}></style>
    <script is:inline>document.documentElement.classList.add('css-wait')</script>
    <meta name="theme-color" content={tone === 'lav' ? '#e0d3ff' : '#cde8fc'} />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
    <title>{fullTitle}</title>
    <link rel="preload" as="font" type="font/woff2" href={heeboHe} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={rubikHe} crossorigin />
    <link rel="icon" href={href('/icons/favicon-64.png')} type="image/png" sizes="64x64" />
    <link rel="manifest" href={href('/manifest.webmanifest')} />
    <link rel="apple-touch-icon" href={href('/icons/180.png')} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="ת״ש צריפין" />
    <link rel="alternate icon" href={href('/favicon.ico')} sizes="32x32" />
    {onVercel ? <Analytics /> : null}
  </head>
  <body>
    <div class="splash" id="splash" aria-hidden="true">
      <div class="sp-cloud c1"></div><div class="sp-cloud c2"></div><div class="sp-cloud c3"></div>
      <div class="sp-stage">
        <div class="sp-ping"></div><div class="sp-ping p2"></div>
        <div class="sp-orbit">
          <svg class="sp-plane" viewBox="0 0 48 48" aria-hidden="true"><path d="M24 2c2 0 3 5 3 11l17 17v4L27 27v10l6 4v4l-9-2-9 2v-4l6-4V27L4 34v-4l17-17c0-6 1-11 3-11z" fill="#fff" stroke="#1b2a6b" stroke-width="1.6" stroke-linejoin="round"/></svg>
        </div>
        <div class="sp-logo-wrap"><div class="sp-wrap-glow"></div><img class="sp-logo" src={href('/logos/app-logo-400.webp')} alt="" width="196" height="196" /></div>
      </div>
      <div class="sp-name">ת״ש חובה בח״א צריפין</div>
      <div class="sp-sub">ממריאים<span class="sp-dots"><i>.</i><i>.</i><i>.</i></span></div>
    </div>
    <a class="skip" href="#main">דילוג לתוכן</a>
    <div class:list={['app', { 'has-head': !hero }]} data-tone={tone}>
      <header class:list={['topbar', { 'hero-bar': hero }]}>
        {back ? (
          <a class="icon-btn" href={href(back)} data-back aria-label="חזרה">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 6 6 6-6 6" /></svg>
          </a>
        ) : hero ? (
          <div class="unit-mark" role="img" aria-label="ת״ש חובה בח״א צריפין">
            {['ofek', 'f108', 'lahav'].map((u) => <img src={href(`/logos/${u}.png`)} alt="" width="44" height="44" decoding="async" />)}
          </div>
        ) : (
          <a class="app-mark" href={href('/')} aria-label="ת״ש חובה בח״א צריפין, לדף הבית"><img src={href('/logos/emblem-144.webp')} alt="" width="48" height="43" decoding="async" /></a>
        )}
        <span class="grow"></span>
        <a class="icon-btn" href={href('/search/')} aria-label="חיפוש"><Icon name="search" /></a>
      </header>

      {!hero ? (
        <div class="page-head">
          <h1>{title ?? SITE_NAME}</h1>
          {lead ? <p class="lead">{lead}</p> : null}
          <div class="head-extra"><slot name="head" /></div>
        </div>
      ) : null}

      <main id="main">
        {SHOW_DRAFTS && draft ? <div class="draft-bar">טיוטה: תוכן שטרם אושר, לא יפורסם באתר</div> : null}
        <slot />
      </main>

      <nav class="dock" aria-label="ניווט ראשי">
        {tabs.map((t, i) => (
          <>
            {i === 2 ? (
              <a class="tab tab-tash" href="https://tash.digital.idf.il/landing/" target="_blank" rel="noopener">
                <span class="tash-orb">
                  <img src={href('/logos/tash-btouch-badge.png')} alt="" width="56" height="56" decoding="async" />
                  <span class="orb-ext" aria-hidden="true"><Icon name="external" /></span>
                </span>
                <span>ת״ש בטאצ׳</span>
                <span class="sr-only">נפתח בלשונית חדשה</span>
              </a>
            ) : null}
            <a class="tab" data-id={t.id} href={href(t.url)} aria-current={t.match(path) ? 'page' : undefined}>
              <Icon name={t.id} />
              <span>{t.label}</span>
            </a>
          </>
        ))}
      </nav>
    </div>
    <div class="toast" id="toast" role="status" aria-live="polite"></div>
    <template id="css-fail">
      <div dir="rtl" style="min-height:100vh;box-sizing:border-box;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12px;padding:32px;text-align:center;background:linear-gradient(180deg,#cde8fc,#e6f3fe 60%,#fff);color:#102b70;font-family:'Heebo Fail',system-ui,sans-serif">
        <img src={href('/logos/emblem-144.webp')} alt="" width="120" height="107" style="width:120px;height:auto;filter:drop-shadow(0 10px 18px rgba(16,43,112,.25))" />
        <div style="margin-top:6px;font:800 28px/1.2 'Rubik Fail',system-ui,sans-serif">משהו השתבש בטעינה</div>
        <div style="max-width:280px;font-size:17px;line-height:1.5;color:#4b5a86">נסו לרענן. אם זה חוזר, בדקו חיבור לאינטרנט ונסו שוב עוד רגע.</div>
        <button id="css-reload" type="button" style="margin-top:10px;padding:14px 38px;border:0;border-radius:999px;background:#102b70;color:#fff;font:700 18px 'Rubik Fail',system-ui,sans-serif;box-shadow:0 8px 20px rgba(16,43,112,.28)">רענון</button>
        <div style="margin-top:18px;font:600 14px 'Rubik Fail',system-ui,sans-serif;color:#5d6b94">ת״ש חובה בח״א צריפין</div>
      </div>
    </template>
    <script is:inline>
      /* אם קובץ העיצוב לא נטען (רשת חלשה או גרסה ישנה במטמון): נסיון רענון אחד, ואם לא עוזר, מסך שגיאה שלנו במקום דף גולמי */
      (function () {
        var d = document.documentElement;
        var ok = getComputedStyle(d).getPropertyValue('--dark').trim() !== '';
        if (ok) { d.classList.remove('css-wait'); return; }
        var tried = false;
        try { tried = sessionStorage.getItem('css-retry') === '1'; sessionStorage.setItem('css-retry', '1'); } catch (e) {}
        if (!tried) {
          var go = function () { location.reload(); };
          try { fetch(location.href, { cache: 'reload' }).then(go, go); } catch (e) { go(); }
          return;
        }
        d.classList.remove('css-wait');
        window.__cssReload = function () { try { sessionStorage.removeItem('css-retry'); } catch (e) {} location.reload(); };
        document.body.innerHTML = document.getElementById('css-fail').innerHTML;
        document.getElementById('css-reload').addEventListener('click', window.__cssReload);
      })();
    </script>
  </body>
</html>

<script>
  // מסך טעינה: פעם אחת בכל כניסה, לפחות רגע קצר כדי שהלוגו ייראה
  (() => {
    const el = document.getElementById('splash');
    if (!el) return;
    let done = false;
    const hide = () => {
      if (done) return;
      done = true;
      try { sessionStorage.setItem('splash', '1'); } catch {}
      el.classList.add('hide');
      setTimeout(() => document.documentElement.classList.remove('splash-on'), 500);
    };
    if (!document.documentElement.classList.contains('splash-on')) return;
    const started = performance.now();
    const ready = () => setTimeout(hide, Math.max(0, 700 - (performance.now() - started)));
    if (document.readyState === 'complete') ready();
    else addEventListener('load', ready, { once: true });
    setTimeout(hide, 2500);
    addEventListener('pageshow', (e) => { if (e.persisted) hide(); });
  })();

  // חזרה אמיתית: אם הגענו מתוך האתר, חוזרים בהיסטוריה (מצב גלילה וסינון נשמרים)
  document.addEventListener('click', (e) => {
    const t = e.target as Element;
    const back = t.closest('a[data-back]');
    if (back && !e.defaultPrevented && !(e as MouseEvent).metaKey && !(e as MouseEvent).ctrlKey) {
      try {
        const r = new URL(document.referrer);
        if (r.origin === location.origin && r.pathname.startsWith(import.meta.env.BASE_URL) && history.length > 1) {
          e.preventDefault();
          history.back();
        }
      } catch {}
      return;
    }
    // לחיצה על הלשונית הפעילה: חזרה לראש העמוד
    const tab = t.closest('.tab[aria-current="page"]');
    if (tab) {
      e.preventDefault();
      scrollTo({ top: 0, behavior: 'smooth' });
    }
  });
  document.addEventListener('touchstart', () => {}, { passive: true });

  // כלל: כותרת העמוד בשורה אחת. מקטינים את הגופן עד שנכנסת (מינימום 20px)
  (() => {
    const h = document.querySelector<HTMLElement>('.page-head h1');
    if (!h) return;
    const fit = () => {
      h.style.fontSize = '';
      let size = parseFloat(getComputedStyle(h).fontSize);
      while (h.scrollWidth > h.clientWidth && size > 20) {
        size -= 1;
        h.style.fontSize = size + 'px';
      }
    };
    fit();
    document.fonts?.ready.then(fit);
    addEventListener('resize', fit);
  })();
</script>

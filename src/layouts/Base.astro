---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { href, SITE_NAME, SHOW_DRAFTS } from '../lib/site';
import Analytics from '@vercel/analytics/astro';
import heeboHe from '@fontsource-variable/heebo/files/heebo-hebrew-wght-normal.woff2?url';
import rubikHe from '@fontsource-variable/rubik/files/rubik-hebrew-wght-normal.woff2?url';

interface Props {
  title?: string;
  /** שורת הסבר מתחת לכותרת בראש העמוד */
  lead?: string;
  description?: string;
  /** חזרה: אם מוגדר מוצג חץ חזרה */
  back?: string;
  draft?: boolean;
  /** גוון השמיים של העמוד */
  tone?: 'sky' | 'lav';
  /** דף הבית: בלי ראש עמוד, הירו משלו */
  hero?: boolean;
}
const { title, lead, description = 'מרכז שירות לחיילי חובה בחיל האוויר בצריפין: זכויות, מדריכים ואנשי קשר בת״ש.', back, draft, tone = 'sky', hero = false } = Astro.props;
const fullTitle = title ? `${title} | ${SITE_NAME}` : SITE_NAME;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = (Astro.url.pathname.startsWith(base) ? Astro.url.pathname.slice(base.length) : Astro.url.pathname) || '/';
const onVercel = !!process.env.VERCEL;
const tabs = [
  { id: 'home', label: 'בית', url: '/', match: (p: string) => p === '/' || p.startsWith('/guide-me') || p.startsWith('/search') },
  { id: 'rights', label: 'זכויות', url: '/rights/', match: (p: string) => p.startsWith('/rights') },
  { id: 'guides', label: 'מדריכים', url: '/guides/', match: (p: string) => p.startsWith('/guides') || p.startsWith('/faq') || p.startsWith('/glossary') },
  { id: 'contacts', label: 'אנשי קשר', url: '/contacts/', match: (p: string) => p.startsWith('/contacts') },
];
---
<!doctype html>
<html lang="he" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content" />
    <meta name="color-scheme" content="light" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="he_IL" />
    <meta property="og:type" content="website" />
    {Astro.site ? <meta property="og:image" content={new URL(href('/og.png'), Astro.site).href} /> : null}
    <script is:inline>try{if(!sessionStorage.getItem('splash'))document.documentElement.classList.add('splash-on')}catch(e){}</script>
    <meta name="theme-color" content={tone === 'lav' ? '#e0d3ff' : '#cde8fc'} />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
    <title>{fullTitle}</title>
    <link rel="preload" as="font" type="font/woff2" href={heeboHe} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={rubikHe} crossorigin />
    <link rel="icon" href={href('/icons/favicon-64.png')} type="image/png" sizes="64x64" />
    <link rel="manifest" href={href('/manifest.webmanifest')} />
    <link rel="apple-touch-icon" href={href('/icons/180.png')} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="ת״ש צריפין" />
    <link rel="alternate icon" href={href('/favicon.ico')} sizes="32x32" />
    {onVercel ? <Analytics /> : null}
  </head>
  <body>
    <div class="splash" id="splash" aria-hidden="true">
      <div class="sp-cloud c1"></div><div class="sp-cloud c2"></div><div class="sp-cloud c3"></div>
      <div class="sp-stage">
        <div class="sp-ping"></div><div class="sp-ping p2"></div>
        <div class="sp-orbit">
          <svg class="sp-plane" viewBox="0 0 48 48" aria-hidden="true"><path d="M24 2c2 0 3 5 3 11l17 17v4L27 27v10l6 4v4l-9-2-9 2v-4l6-4V27L4 34v-4l17-17c0-6 1-11 3-11z" fill="#fff" stroke="#1b2a6b" stroke-width="1.6" stroke-linejoin="round"/></svg>
        </div>
        <div class="sp-logo-wrap"><div class="sp-wrap-glow"></div><img class="sp-logo" src={href('/logos/app-emblem-400.webp')} alt="" width="196" height="190" /></div>
      </div>
      <div class="sp-name">ת״ש חובה בח״א צריפין</div>
      <div class="sp-sub">ממריאים<span class="sp-dots"><i>.</i><i>.</i><i>.</i></span></div>
    </div>
    <a class="skip" href="#main">דילוג לתוכן</a>
    <div class:list={['app', { 'has-head': !hero }]} data-tone={tone}>
      <header class:list={['topbar', { 'hero-bar': hero }]}>
        {back ? (
          <a class="icon-btn" href={href(back)} data-back aria-label="חזרה">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 6 6 6-6 6" /></svg>
          </a>
        ) : hero ? (
          <div class="unit-mark" role="img" aria-label="ת״ש חובה בח״א צריפין">
            {['ofek', 'lahav', 'f108'].map((u) => <img src={href(`/logos/${u}.png`)} alt="" width="44" height="44" decoding="async" />)}
          </div>
        ) : (
          <a class="app-mark" href={href('/')} aria-label="ת״ש חובה בח״א צריפין, לדף הבית"><img src={href('/logos/app-logo-96.webp')} alt="" width="40" height="40" decoding="async" /></a>
        )}
        <span class="grow"></span>
        <a class="icon-btn" href={href('/search/')} aria-label="חיפוש"><Icon name="search" /></a>
      </header>

      {!hero ? (
        <div class="page-head">
          <h1>{title ?? SITE_NAME}</h1>
          {lead ? <p class="lead">{lead}</p> : null}
          <div class="head-extra"><slot name="head" /></div>
        </div>
      ) : null}

      <main id="main">
        {SHOW_DRAFTS && draft ? <div class="draft-bar">טיוטה: תוכן שטרם אושר, לא יפורסם באתר</div> : null}
        <slot />
      </main>

      <nav class="dock" aria-label="ניווט ראשי">
        {tabs.map((t) => (
          <a class="tab" data-id={t.id} href={href(t.url)} aria-current={t.match(path) ? 'page' : undefined}>
            <Icon name={t.id} />
            <span>{t.label}</span>
          </a>
        ))}
      </nav>
    </div>
    <div class="toast" id="toast" role="status" aria-live="polite"></div>
  </body>
</html>

<script>
  // מסך טעינה: פעם אחת בכל כניסה, לפחות רגע קצר כדי שהלוגו ייראה
  (() => {
    const el = document.getElementById('splash');
    if (!el) return;
    let done = false;
    const hide = () => {
      if (done) return;
      done = true;
      try { sessionStorage.setItem('splash', '1'); } catch {}
      el.classList.add('hide');
      setTimeout(() => document.documentElement.classList.remove('splash-on'), 500);
    };
    if (!document.documentElement.classList.contains('splash-on')) return;
    const started = performance.now();
    const ready = () => setTimeout(hide, Math.max(0, 1000 - (performance.now() - started)));
    if (document.readyState === 'complete') ready();
    else addEventListener('load', ready, { once: true });
    setTimeout(hide, 2500);
    addEventListener('pageshow', (e) => { if (e.persisted) hide(); });
  })();

  // חזרה אמיתית: אם הגענו מתוך האתר, חוזרים בהיסטוריה (מצב גלילה וסינון נשמרים)
  document.addEventListener('click', (e) => {
    const t = e.target as Element;
    const back = t.closest('a[data-back]');
    if (back && !e.defaultPrevented && !(e as MouseEvent).metaKey && !(e as MouseEvent).ctrlKey) {
      try {
        const r = new URL(document.referrer);
        if (r.origin === location.origin && r.pathname.startsWith(import.meta.env.BASE_URL) && history.length > 1) {
          e.preventDefault();
          history.back();
        }
      } catch {}
      return;
    }
    // לחיצה על הלשונית הפעילה: חזרה לראש העמוד
    const tab = t.closest('.tab[aria-current="page"]');
    if (tab) {
      e.preventDefault();
      scrollTo({ top: 0, behavior: 'smooth' });
    }
  });
  document.addEventListener('touchstart', () => {}, { passive: true });
</script>

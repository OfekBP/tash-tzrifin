---
import { getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import JumpNav from '../../components/JumpNav.astro';
import { docTypeOf } from '../../lib/docs';
import { inline, splitSections } from '../../lib/md';
import { href, isDraft, isVisible, SHOW_DRAFTS, visible } from '../../lib/site';

export async function getStaticPaths() {
  const rights = await visible('rights');
  return rights.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const d = entry.data;

// פירוט נוסף בגוף הקובץ: כל "## כותרת" הופכת לכרטיס נפתח
const { intro: introHtml, parts } = splitSections(entry.body);

const related = (await Promise.all(d.related.map((r) => getEntry(r)))).filter((r) => r && isVisible(r as never)) as any[];

// מי זכאי ומה מקבלים פתוחים כברירת מחדל: אלה השאלות הראשונות של מי שנכנס לעמוד
const lists = [
  { id: 'who', title: 'למי זה מיועד?', short: 'למי מיועד', items: d.eligibility, open: true },
  { id: 'conditions', title: 'תנאי זכאות', short: 'תנאים', items: d.conditions, open: true },
  { id: 'benefits', title: 'מה מקבלים בפועל', short: 'מה מקבלים', items: d.benefits, open: true },
].filter((s) => s.items.length > 0);

// שורת קפיצה, רק בעמוד ארוך (7 סעיפים נפתחים ומעלה)
const jump = [
  ...lists.map((s) => [`sec-${s.id}`, s.short]),
  d.figures.length > 0 ? ['sec-figures', 'סכומים'] : null,
  d.documents.length > 0 ? ['sec-documents', 'מסמכים'] : null,
  d.how_to_apply.length > 0 ? ['sec-apply', 'איך מגישים'] : null,
  d.approver ? ['sec-approver', 'מי מאשר'] : null,
  d.exceptions.length > 0 ? ['sec-notes', 'חשוב לדעת'] : null,
  parts.length > 0 ? ['sec-parts', 'פירוט'] : null,
  d.faq.length > 0 ? ['sec-faq', 'שאלות'] : null,
].filter((x): x is [string, string] => x !== null);
const accordions = jump.length - (parts.length > 0 ? 1 : 0) - (d.faq.length > 0 ? 1 : 0) + parts.length + d.faq.length;

const asOf = (v: string) => (/^\d{4}/.test(v) ? `נכון ל-${v}` : v);
---
<Base title={d.title} lead={d.lead} back="/rights/" tone="lav" draft={isDraft(entry)}>
  {SHOW_DRAFTS && d.to_verify.length > 0 ? (
    <div class="draft-bar" style="margin-bottom: var(--s4)">לבדיקה לפני אישור: {d.to_verify.join(' · ')}</div>
  ) : null}

  {accordions >= 7 ? <JumpNav items={jump} label="קפיצה לסעיף בעמוד" /> : null}

  <div>
    {lists.map((s, i) => (
      <details class="acc" id={`sec-${s.id}`} open={s.open || i === 0}>
        <summary><h2>{s.title}</h2></summary>
        <div class="acc-body"><ul>{s.items.map((x) => <li set:html={inline(x)} />)}</ul></div>
      </details>
    ))}

    {d.figures.length > 0 ? (
      <details class="acc" id="sec-figures" open>
        <summary><h2>סכומים ומספרים</h2></summary>
        <div class="acc-body">
          <ul class="figs">
            {d.figures.map((f) => (
              <li>
                <span>{f.label}</span>
                <strong>{f.value}{f.unit ? ` ${f.unit}` : ''}</strong>
                <span class="muted small">{asOf(f.asOf)}</span>
              </li>
            ))}
          </ul>
        </div>
      </details>
    ) : null}

    {d.documents.length > 0 ? (
      <details class="acc" id="sec-documents" open data-docs={entry.id}>
        <summary><h2>מסמכים שצריך להכין</h2></summary>
        <div class="acc-body">
          <p class="muted small" style="margin: 0 0 var(--s3)">סמנו מה כבר הכנתם. הסימון נשמר רק במכשיר הזה.</p>
          <ul class="checklist">
            {d.documents.map((x) => {
              const doc = docTypeOf(x);
              return (
                <li>
                  <label><input type="checkbox" data-doc-key={x} /><span set:html={inline(x)} /></label>
                  {doc ? <a class="doc-how" href={href(`/guides/banks/?doc=${doc}`)}>איך מפיקים?</a> : null}
                </li>
              );
            })}
          </ul>
        </div>
      </details>
    ) : null}

    {d.how_to_apply.length > 0 ? (
      <details class="acc" id="sec-apply" open>
        <summary><h2>איך מגישים בקשה</h2></summary>
        <div class="acc-body"><ol class="steps">{d.how_to_apply.map((x) => <li set:html={inline(x)} />)}</ol></div>
      </details>
    ) : null}

    {d.approver ? (
      <details class="acc" id="sec-approver">
        <summary><h2>מי מאשר?</h2></summary>
        <div class="acc-body">{d.approver}</div>
      </details>
    ) : null}

    {d.exceptions.length > 0 ? (
      <details class="acc" id="sec-notes" open>
        <summary><h2>חשוב לדעת</h2></summary>
        <div class="acc-body"><ul>{d.exceptions.map((x) => <li set:html={inline(x)} />)}</ul></div>
      </details>
    ) : null}
  </div>

  {introHtml ? <div class="prose" set:html={introHtml} style="margin-top: var(--s4)" /> : null}
  {parts.length > 0 ? (
    <>
      <h2 class="section" id="sec-parts" tabindex="-1">פירוט לפי נושא</h2>
      <div>
        {parts.map((p) => (
          <details class="acc" open={parts.length === 1 || undefined}>
            <summary><h3>{p.title}</h3></summary>
            <div class="acc-body prose" set:html={p.html} />
          </details>
        ))}
      </div>
    </>
  ) : null}

  {d.faq.length > 0 ? (
    <>
      <h2 class="section" id="sec-faq" tabindex="-1">שאלות נפוצות</h2>
      <div>
        {d.faq.map((f) => (
          <details class="acc"><summary><h3>{f.q}</h3></summary><div class="acc-body">{f.a}</div></details>
        ))}
      </div>
    </>
  ) : null}

  {related.length > 0 ? (
    <>
      <h2 class="section">כדאי לראות גם</h2>
      <div class="group">
        {related.map((r) => (
          <a class="row" href={href(`/rights/${r.id}/`)}>
            <span class="tx"><span class="t">{r.data.title}</span><span class="s">{r.data.summary}</span></span>
            <Icon name="chevron" class="chev" />
          </a>
        ))}
      </div>
    </>
  ) : null}

  <p class="sources">
    {d.lastVerified ? `עודכן לאחרונה: ${d.lastVerified.toLocaleDateString('he-IL')}. ` : ''}
    {d.sources.length > 0 ? `מקור: ${[...new Set(d.sources.map((s) => s.doc))].map((doc) => `${doc === 'book' ? 'הספר המקצועי' : doc}, עמ׳ ${d.sources.filter((s) => s.doc === doc).map((s) => s.page).join(', ')}`).join('; ')}.` : ''}
  </p>
</Base>

<script>
  // רשימת מסמכים עם סימון שנשמר במכשיר. הסימון נשמר לפי שם המסמך, כדי שעריכת הרשימה לא תזיז סימונים למסמך אחר.
  document.querySelectorAll<HTMLElement>('[data-docs]').forEach((box) => {
    const key = `docs:${box.dataset.docs}`;
    const boxes = [...box.querySelectorAll<HTMLInputElement>('input[type=checkbox]')];
    let saved: Record<string, boolean> = {};
    try { saved = JSON.parse(localStorage.getItem(key) ?? '{}'); } catch {}
    const store = () => { try { localStorage.setItem(key, JSON.stringify(saved)); } catch {} };

    // סימונים מגרסה קודמת נשמרו לפי מיקום ברשימה (0, 1, 2...): מעבירים אותם פעם אחת לשם המסמך
    const old = Object.keys(saved).filter((k) => /^\d+$/.test(k));
    for (const k of old) {
      const cb = boxes[+k];
      if (cb && saved[k]) saved[cb.dataset.docKey!] = true;
      delete saved[k];
    }
    if (old.length) store();

    for (const cb of boxes) {
      cb.checked = !!saved[cb.dataset.docKey!];
      cb.addEventListener('change', () => {
        if (cb.checked) saved[cb.dataset.docKey!] = true;
        else delete saved[cb.dataset.docKey!];
        store();
      });
    }
  });
</script>

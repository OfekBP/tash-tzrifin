---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { href, isDraft, visible } from '../../lib/site';

const guides = (await visible('guides')).sort((a, b) => a.data.order - b.data.order);
const links = await visible('links');
const tashLink = links.find((l) => l.id === 'tash-btouch');
---
<Base title="מדריכים וכלים" lead="ארגז כלים לעשייה בפועל" description="מדריכים פרקטיים לחייל: אישורים מהבנק, ת״ש בטאצ׳ ועוד">
  <div class="group">
    {guides.map((g) => (
      <>
      <a class="row" href={href(`/guides/${g.id}/`)}>
        <span class="dot tint"><Icon name="doc" /></span>
        <span class="tx">
          <span class="t">{g.data.title}{isDraft(g) ? <span class="badge" style="margin-inline-start: 8px">טיוטה</span> : null}</span>
          <span class="s">{g.data.summary}</span>
        </span>
        <Icon name="chevron" class="chev" />
      </a>
      {g.id === 'financial-documents' ? (
    <a class="row" href={href('/guides/banks/')}>
      <span class="dot tint"><Icon name="doc" /></span>
      <span class="tx"><span class="t">אישורים מהבנק</span><span class="s">ריכוז יתרות, עו״ש, פירוט אשראי ואישור בעלות חשבון</span></span>
      <Icon name="chevron" class="chev" />
    </a>
      ) : null}
      </>
    ))}
    <a class="row" href={href('/faq/')}>
      <span class="dot tint"><Icon name="doc" /></span>
      <span class="tx"><span class="t">שאלות נפוצות</span><span class="s">תשובות קצרות לשאלות שחוזרות</span></span>
      <Icon name="chevron" class="chev" />
    </a>
    <a class="row" href={href('/glossary/')}>
      <span class="dot tint"><Icon name="doc" /></span>
      <span class="tx"><span class="t">מילון מושגים</span><span class="s">הת״ש, תשמ״ש, הלנה, ריכוז יתרות ועוד</span></span>
      <Icon name="chevron" class="chev" />
    </a>
    {!guides.some((g) => g.id === 'tash-btouch') && tashLink ? (
      <a class="row" href={tashLink.data.url} target="_blank" rel="noopener">
        <span class="dot tint"><Icon name="external" /></span>
        <span class="tx"><span class="t">{tashLink.data.title}</span><span class="s">{tashLink.data.description}</span></span>
        <Icon name="chevron" class="chev" />
      </a>
    ) : null}
  </div>
</Base>
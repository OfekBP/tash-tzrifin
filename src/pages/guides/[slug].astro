---
import Base from '../../layouts/Base.astro';
import TashButton from '../../components/TashButton.astro';
import Icon from '../../components/Icon.astro';
import Walkthrough from '../../components/Walkthrough.astro';
import { splitSections } from '../../lib/md';
import { href, isDraft, visible } from '../../lib/site';

export async function getStaticPaths() {
  const guides = await visible('guides');
  return guides.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const d = entry.data;

// גוף המדריך: פתיח + כרטיסים נפתחים לפי "## כותרת"
const { intro, parts } = splitSections(entry.body);
---
<Base title={d.title} lead={d.lead} back="/guides/" draft={isDraft(entry)}>
  {d.link ? (
    d.link.includes('tash.digital.idf.il') ? (
      <TashButton url={d.link} label={d.linkLabel} />
    ) : (
      <a class="btn purple block" href={d.link} target="_blank" rel="noopener"><Icon name="external" />{d.linkLabel ?? 'לפתיחה'}</a>
    )
  ) : null}

  {intro ? <div class="prose" style="margin-top: var(--s5)" set:html={intro} /> : null}

  {d.videos.length > 0 ? (
    <section class="videos-sec">
      <h2 class="section">סרטוני הדרכה</h2>
      <div class="videos">
        {d.videos.map((v, i) => (
          <figure class="video-card">
            <figcaption>
              <span class="vnum">{i + 1}</span>
              <span class="vtitle">{v.title}</span>
              <span class="vdur" data-dur></span>
            </figcaption>
            <video controls playsinline preload="none" width={v.width} height={v.height} style={`aspect-ratio: ${v.width} / ${v.height}`} data-src={href(`/videos/${entry.id}/${v.file}#t=0.1`)} aria-label={v.title}></video>
            {v.note ? <p class="vnote">{v.note}</p> : null}
          </figure>
        ))}
      </div>
    </section>
  ) : null}

  {d.walkthrough ? <Walkthrough guide={entry.id} w={d.walkthrough} /> : null}

  {parts.length > 0 && d.steps ? (
    <ol class="timeline">
      {parts.map((p) => (
        <li>
          <h2>{p.title}</h2>
          <div class="prose" set:html={p.html} />
        </li>
      ))}
    </ol>
  ) : parts.length > 0 ? (
    <div style="margin-top: var(--s5)">
      {parts.map((p, i) => (
        <details class="acc" open={i === 0}>
          <summary>{p.title}</summary>
          <div class="acc-body prose" set:html={p.html} />
        </details>
      ))}
    </div>
  ) : null}
</Base>

<script>
  // הסרטונים נטענים רק כשמתקרבים אליהם (חוסך נתונים וזמן טעינה)
  const vids = [...document.querySelectorAll<HTMLVideoElement>('.video-card video')];
  const load = (v: HTMLVideoElement) => {
    if (v.dataset.src) {
      v.preload = 'metadata';
      v.src = v.dataset.src;
      delete v.dataset.src;
    }
  };
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (es) => es.forEach((e) => { if (e.isIntersecting) { load(e.target as HTMLVideoElement); io.unobserve(e.target); } }),
      { rootMargin: '400px' },
    );
    vids.forEach((v) => io.observe(v));
  } else vids.forEach(load);

  // משך כל סרטון בכותרת הכרטיס
  document.querySelectorAll<HTMLVideoElement>('.video-card video').forEach((v) => {
    const out = v.closest('.video-card')!.querySelector<HTMLElement>('[data-dur]')!;
    const show = () => {
      const s = Math.round(v.duration);
      if (s) out.textContent = `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;
    };
    if (v.readyState >= 1) show();
    else v.addEventListener('loadedmetadata', show, { once: true });
  });
</script>

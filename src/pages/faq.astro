---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageSearch from '../components/PageSearch.astro';
import { href, isVisible } from '../lib/site';

const faq = (await getCollection('faq')).sort((a, b) => a.data.order - b.data.order);
const allRights = new Map((await getCollection('rights')).filter(isVisible).map((r) => [r.id, r]));
const groups = [...new Set(faq.map((f) => f.data.group))];
---
<Base back="/guides/" title="שאלות נפוצות" lead="תשובות לשאלות שחוזרות הכי הרבה" description="שאלות ותשובות על ת״ש, זכויות, עבודה, חופשות ומסמכים">
  <PageSearch slot="head" placeholder="חיפוש בשאלות: חופשה, מסמכים…" label="חיפוש בשאלות" suggestions={['חופשה', 'מסמכים', 'היתר עבודה', 'תווי קנייה']} />

  {groups.map((g) => (
    <section data-group>
      <h2 class="section">{g}</h2>
      <div>
        {faq.filter((f) => f.data.group === g).map((f) => (
          <details class="acc" data-faq data-search={`${f.data.q}|${f.data.group}|${f.data.a}`}>
            <summary data-hl>{f.data.q}</summary>
            <div class="acc-body">
              <p style="margin: 0" data-hl>{f.data.a}</p>
              {f.data.rights.filter((r) => allRights.has(r.id)).map((r) => (
                <a class="btn ghost" style="margin-top: var(--s3); min-height: 44px" href={href(`/rights/${r.id}/`)}>{allRights.get(r.id)!.data.title}</a>
              ))}
            </div>
          </details>
        ))}
      </div>
    </section>
  ))}
  <p class="ps-empty" data-ps-empty hidden></p>

  <div class="card-soft" style="margin-top: var(--s6)">
    <strong>לא מצאת תשובה?</strong>
    <p>מש״קית הת״ש תעזור לך, לפי המסגרת והענף שלך.</p>
    <a class="btn purple block" href={href('/contacts/')}>לאנשי הקשר</a>
  </div>
</Base>

<script>
  import { initPageSearch } from '../lib/page-search';
  initPageSearch({
    input: document.getElementById('q') as HTMLInputElement,
    items: [...document.querySelectorAll<HTMLElement>('[data-faq]')],
    groups: [...document.querySelectorAll<HTMLElement>('[data-group]')],
    empty: document.querySelector('[data-ps-empty]'),
    count: document.getElementById('ps-count'),
    clear: document.getElementById('ps-clear'),
    suggest: document.getElementById('ps-suggest'),
  });
</script>

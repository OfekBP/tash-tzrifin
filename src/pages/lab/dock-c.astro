---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import HeroSky from '../../components/HeroSky.astro';
import { href, SITE_NAME } from '../../lib/site';

---
<Base hero>
  <section class="hero">
    <div class="hero-copy">
      <h1>{SITE_NAME}</h1>
      <span class="title-line" aria-hidden="true"></span>
    </div>
    <HeroSky />
  </section>

  <h2 class="sr-only">מה תרצו לעשות?</h2>
  <div class="bento">
    <a class="tile wide" href={href('/rights/')}>
      <span class="ico"><Icon name="rights" /></span>
      <strong>זכויות והטבות</strong>
      <span class="d">מה מגיע לך</span>
    </a>
    <a class="tile tint" href={href('/guides/')}>
      <span class="ico"><Icon name="guides" /></span>
      <strong>מדריכים וכלים</strong>
      <span class="d">הסברים והדרכות</span>
    </a>
    <a class="tile mist" href={href('/contacts/')}>
      <span class="ico"><Icon name="contacts" /></span>
      <strong>אנשי קשר</strong>
      <span class="d">אל מי לפנות</span>
    </a>
    <a class="tile mist" href={href('/faq/')}>
      <span class="ico"><Icon name="doc" /></span>
      <strong>שאלות נפוצות</strong>
      <span class="d">מה כולם שואלים</span>
    </a>
    <a class="tile tint" href={href('/guide-me/')}>
      <span class="ico"><Icon name="search" /></span>
      <strong>מאיפה מתחילים?</strong>
      <span class="d">שאלון קצר לאפיון</span>
    </a>
  </div>


  <p class="notice" style="margin-top: var(--s6)">האתר נועד לעזור, כדי לדעת מה מגיע לך בפועל, פנו לצוות הת״ש בבסיס.</p>

</Base>

<style is:global>
  .dock { background: transparent !important; border: 0 !important; box-shadow: none !important; filter: none !important; backdrop-filter: none !important; -webkit-backdrop-filter: none !important; }
  .dock::before, .dock::after {
    content: ''; position: absolute; top: 0; bottom: 0; z-index: -1; display: block;
    border-radius: 30px; mask: none !important; -webkit-mask: none !important;
    background: rgb(255 255 255 / 0.95);
    backdrop-filter: blur(18px) saturate(1.5); -webkit-backdrop-filter: blur(18px) saturate(1.5);
    box-shadow: 0 12px 24px -6px rgb(40 80 170 / 0.28), inset 0 0 0 1px rgb(255 255 255 / 0.9);
    width: auto; height: auto; margin: 0; transform: none;
  }
  /* RTL: slots 1-2 are on the right, 4-5 on the left; gap = one column */
  .dock::before { left: auto; right: 0; width: calc(50% - (100% - 28px) / 10 - 3px); }
  .dock::after { right: auto; left: 0; width: calc(50% - (100% - 28px) / 10 - 3px); }
  .tash-orb {
    box-shadow: 0 0 0 3px rgb(255 255 255 / 0.95), 0 0 0 7px rgb(255 255 255 / 0.35), 0 12px 20px -6px rgb(106 63 214 / 0.6) !important;
  }
  .tab-tash::after {
    content: ''; position: absolute; z-index: -1; left: 50%; top: 0; bottom: 0; width: 66px; margin-left: -33px;
    border-radius: 30px; background: rgb(255 255 255 / 0.8);
    backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
  }
</style>

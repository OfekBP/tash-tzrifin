---
import { getCollection, getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import ContactCard from '../components/ContactCard.astro';
import Icon from '../components/Icon.astro';
import PageSearch from '../components/PageSearch.astro';
import WaLogo from '../components/WaLogo.astro';
import { href, isVisible, TECH_CONTACT_ID } from '../lib/site';
const logos: Record<string, string> = { ofek: 'ofek', lahav: 'lahav', f108: 'f108', f502: 'f502' };
const hues: Record<string, 'a' | 'b' | 'c' | 'd'> = { ofek: 'a', lahav: 'b', f108: 'c', f502: 'd' };

const frameworks = (await getCollection('frameworks')).sort((a, b) => a.data.order - b.data.order);
const people = new Map((await getCollection('people')).filter(isVisible).map((p) => [p.id, p]));
const assignments = (await getCollection('assignments')).filter((a) => people.has(a.data.person.id));
const tech = people.get(TECH_CONTACT_ID);

const groups = frameworks
  .map((f) => ({ f, items: assignments.filter((a) => a.data.framework.id === f.id) }))
  .filter((g) => g.items.length > 0);
---
<Base title="אנשי קשר" lead="המש״קית של היחידה שלך" description="מש״קיות ומש״קי הת״ש לפי מסגרת ויחידה">
  <PageSearch slot="head" placeholder="חיפוש יחידה או שם" label="חיפוש יחידה או שם" suggestions={groups.slice(0, 4).map((g) => g.f.data.name)} />

  <div class="chips" role="group" aria-label="מסגרת">
    <button class="chip" type="button" data-fw="all" aria-pressed="true">הכול</button>
    {groups.map((g) => <button class="chip" type="button" data-fw={g.f.id} aria-pressed="false">{logos[g.f.id] ? <img class="fw-logo" src={href(`/logos/${logos[g.f.id]}.webp`)} alt="" width="40" height="40" decoding="async" /> : null}{g.f.data.name}</button>)}
  </div>

  <div id="groups">
    {groups.map((g) => (
      <section data-group={g.f.id}>
        <h2 class="section fw">
          {logos[g.f.id] ? <img class="fw-logo" src={href(`/logos/${logos[g.f.id]}.webp`)} alt="" width="40" height="40" decoding="async" /> : <span class="fw-logo fw-mono" aria-hidden="true">{g.f.data.name}</span>}
          {g.f.data.name}
        </h2>
        <div class="group">
          {g.items.map((a) => {
            const p = people.get(a.data.person.id)!;
            return <ContactCard id={`${a.id}`} name={p.data.name} phone={p.data.phone} whatsapp={p.data.whatsapp} units={a.data.units} framework={g.f.data.name} hue={hues[g.f.id] ?? 'a'} />;
          })}
        </div>
      </section>
    ))}
  </div>
  <p class="ps-empty" data-ps-empty hidden></p>

  <dialog class="sheet" id="sheet" aria-labelledby="sheet-name">
    <div class="grab" aria-hidden="true"></div>
    <div class="sheet-head">
      <span class="avatar" id="sheet-av" aria-hidden="true"></span>
      <div>
        <h2 id="sheet-name" tabindex="-1" autofocus></h2>
        <p class="muted small" id="sheet-sub" style="margin: 0"></p>
      </div>
    </div>
    <span class="num" id="sheet-num"></span>
    <div class="acts">
      <a class="btn block" id="sheet-call" href="#"><Icon name="phone" />חיוג</a>
      <a class="btn wa block" id="sheet-wa" href="#" target="_blank" rel="noopener" hidden><WaLogo />פתיחת צ׳אט בוואטסאפ</a>
      <button class="btn ghost block" id="sheet-copy" type="button"><Icon name="copy" />העתקת מספר</button>
      <button class="btn ghost" id="sheet-close" type="button">סגירה</button>
    </div>
  </dialog>

  {tech ? (
    <section id="bug">
      <h2 class="section">דיווח על תקלה / הצעה לשיפור</h2>
      <div class="group"><ContactCard id={tech.id} name={tech.data.name} phone={tech.data.phone} whatsapp={tech.data.whatsapp} role="תקלה באתר או הצעה לשיפור" hue="b" /></div>
    </section>
  ) : null}
</Base>

<script>
  import { initPageSearch } from '../lib/page-search';
  import { getParam, setParam } from '../lib/url';
  import { modalHistory } from '../lib/modal-history';

  const chips = [...document.querySelectorAll<HTMLButtonElement>('[data-fw]')];
  const groups = [...document.querySelectorAll<HTMLElement>('#groups [data-group]')];
  // המסגרת שנבחרה נשמרת בכתובת (?fw=), כדי שרענון או שיתוף קישור יחזירו לאותה רשימה
  const fromUrl = getParam('fw');
  let fw = chips.some((c) => c.dataset.fw === fromUrl) ? fromUrl : 'all';
  const mark = () => chips.forEach((x) => x.setAttribute('aria-pressed', String(x.dataset.fw === fw)));
  mark();
  const ps = initPageSearch({
    input: document.getElementById('q') as HTMLInputElement,
    items: [...document.querySelectorAll<HTMLElement>('#groups [data-person]')],
    groups,
    extra: (el) => fw === 'all' || el.closest<HTMLElement>('[data-group]')?.dataset.group === fw,
    empty: document.querySelector('[data-ps-empty]'),
    count: document.getElementById('ps-count'),
    clear: document.getElementById('ps-clear'),
    suggest: document.getElementById('ps-suggest'),
  });

  chips.forEach((c) =>
    c.addEventListener('click', () => {
      fw = c.dataset.fw!;
      mark();
      setParam('fw', fw === 'all' ? '' : fw);
      c.scrollIntoView({ inline: 'center', block: 'nearest', behavior: 'smooth' });
      ps.refresh(false);
    }),
  );
  const active = chips.find((c) => c.dataset.fw === fw);
  const row = active?.parentElement?.getBoundingClientRect();
  if (active && fw !== 'all' && row && row.top >= 0 && row.bottom <= innerHeight) active.scrollIntoView({ inline: 'center', block: 'nearest' });

  // דף תחתון: פרטי איש קשר, חיוג, העתקה
  const sheet = document.getElementById('sheet') as HTMLDialogElement;
  const $ = (id: string) => document.getElementById(id)!;
  const toast = $('toast');
  let timer: number;
  let current = '';
  function say(msg: string) {
    toast.textContent = msg;
    toast.classList.add('show');
    clearTimeout(timer);
    timer = window.setTimeout(() => toast.classList.remove('show'), 1800);
  }
  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-open]');
    if (!btn) return;
    const d = btn.dataset;
    current = d.phone!;
    $('sheet-name').textContent = d.name!;
    $('sheet-sub').textContent = d.sub ?? '';
    $('sheet-sub').hidden = !d.sub;
    const av = $('sheet-av');
    av.textContent = d.name!.trim()[0];
    av.dataset.h = d.hue;
    $('sheet-num').textContent = d.shown!;
    ($('sheet-call') as HTMLAnchorElement).href = d.tel!;
    const wa = $('sheet-wa') as HTMLAnchorElement;
    wa.hidden = !d.wa;
    if (d.wa) wa.href = d.wa;
    sheet.showModal();
    sheetHistory.opened();
  });
  // כפתור חזרה של המכשיר סוגר את החלון במקום לצאת מהעמוד
  const sheetHistory = modalHistory(sheet);
  // גרירה מטה על הידית או על ראש הדף סוגרת אותו
  {
    let y0 = 0, dy = 0, active = false;
    const start = (e: PointerEvent) => {
      const t = e.target as Element;
      if (!t.closest('.grab, .sheet-head') && !(sheet.scrollTop === 0 && !t.closest('button, a'))) return;
      if (sheet.scrollTop > 0 && !t.closest('.grab')) return;
      active = true; y0 = e.clientY; dy = 0; sheet.classList.add('dragging');
    };
    const move = (e: PointerEvent) => {
      if (!active) return;
      dy = Math.max(0, e.clientY - y0);
      sheet.style.transform = `translateY(${dy}px)`;
    };
    const end = () => {
      if (!active) return;
      active = false; sheet.classList.remove('dragging');
      sheet.style.transform = '';
      if (dy > 90) sheet.close();
    };
    sheet.addEventListener('pointerdown', start);
    sheet.addEventListener('pointermove', move);
    sheet.addEventListener('pointerup', end);
    sheet.addEventListener('pointercancel', end);
  }
  $('sheet-close').addEventListener('click', () => sheet.close());
  sheet.addEventListener('click', (e) => {
    if (e.target === sheet) sheet.close();
  });
  $('sheet-copy').addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(current);
      say('המספר הועתק');
    } catch {
      say(`המספר: ${current}`);
    }
    sheet.close();
  });
</script>

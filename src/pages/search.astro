---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { href } from '../lib/site';
---
<Base title="חיפוש" lead="זכות, מדריך, בנק, יחידה או שם." back="/">
  <div slot="head" class="searchbar">
    <Icon name="search" />
    <input type="search" id="q" placeholder="למשל: ריכוז יתרות, חופשה, ליאן" aria-label="חיפוש" autocomplete="off" enterkeyhint="search" />
  </div>
  <p class="muted small" id="hint">התחילו להקליד, והתוצאות יופיעו כאן.</p>
  <p class="sr-only" role="status" id="count"></p>
  <div class="group" id="results"></div>
</Base>

<script define:vars={{ indexUrl: href('/search-index.json') }}>
  window.__indexUrl = indexUrl;
</script>
<script>
  import MiniSearch from 'minisearch';
  import { normalize, tokenize } from '../lib/text';

  const q = document.getElementById('q') as HTMLInputElement;
  const results = document.getElementById('results')!;
  const hint = document.getElementById('hint')!;

  const count = document.getElementById('count')!;
  const ready = (async () => {
    const res = await fetch((window as any).__indexUrl);
    const docs = await res.json();
    const ms = new MiniSearch({
      fields: ['title', 'keywords', 'summary'],
      storeFields: ['title', 'type', 'summary', 'url'],
      tokenize,
      searchOptions: { prefix: true, fuzzy: (t: string) => (t.length > 4 ? 0.15 : 0), boost: { title: 3, keywords: 2 }, combineWith: 'AND', tokenize },
    });
    ms.addAll(docs);
    return ms;
  })().catch(() => null);

  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);

  async function run() {
    const term = q.value.trim();
    history.replaceState(null, '', term ? `?q=${encodeURIComponent(term)}` : location.pathname);
    if (!normalize(term)) {
      results.innerHTML = '';
      hint.hidden = false;
      return;
    }
    hint.hidden = true;
    const ms = await ready;
    if (!ms) {
      results.innerHTML = '<p class="empty">החיפוש לא זמין כרגע. נסו שוב מאוחר יותר.</p>';
      return;
    }
    const hits = ms.search(term).slice(0, 20);
    count.textContent = hits.length ? `נמצאו ${hits.length} תוצאות` : 'לא נמצאו תוצאות';
    results.innerHTML = hits.length
      ? hits.map((h: any) => `<a class="result" href="${esc(h.url)}"><div class="t">${esc(h.title)}</div><div class="s">${esc(h.type)}${h.summary ? ' · ' + esc(h.summary) : ''}</div></a>`).join('')
      : '<p class="empty">לא מצאנו תוצאות. נסו מילה אחרת, או פנו למש״קית הת״ש דרך לשונית אנשי הקשר.</p>';
  }

  let t: number;
  q.addEventListener('input', () => { clearTimeout(t); t = window.setTimeout(run, 120); });
  q.addEventListener('keydown', (e) => { if (e.key === 'Enter') q.blur(); });
  const initial = new URLSearchParams(location.search).get('q');
  if (initial) {
    q.value = initial;
    run();
  }
</script>

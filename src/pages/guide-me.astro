---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { href, isVisible } from '../lib/site';

const branches = (await getCollection('quiz')).sort((a, b) => a.data.order - b.data.order).map((b) => ({
  id: b.id,
  label: b.data.label,
  base: b.data.base.map((r) => r.id),
  questions: b.data.questions.map((q) => ({ q: q.q, options: q.options.map((o) => ({ label: o.label, add: o.add.map((r) => r.id) })) })),
}));
const rights = Object.fromEntries(
  (await getCollection('rights')).filter(isVisible).map((r) => [r.id, { title: r.data.title, summary: r.data.summary, url: href(`/rights/${r.id}/`) }]),
);
const payload = JSON.stringify({ branches, rights, contacts: href('/contacts/'), rightsList: href('/rights/'), logo: href('/logos/tash-btouch-badge.webp'), banks: href('/guides/banks/'), docs: href('/guides/financial-documents/') });
---
<Base title="מאיפה מתחילים?" lead="כמה שאלות קצרות, ונכוון אותך" back="/" description="שאלון קצר שמכוון לזכויות ולמסלולי הסיוע הרלוונטיים">
  <div id="app" data-payload={payload}>
    <p class="quiz-progress" id="quiz-progress" hidden></p>
    <h2 class="section" id="step-title" tabindex="-1">מה הקושי העיקרי שלך?</h2>
    <div class="group" id="options"></div>
    <div class="quiz-nav" id="quiz-nav" hidden>
      <button class="btn ghost" id="back-step" type="button">חזרה לשאלה הקודמת</button>
      <button class="btn ghost" id="restart" type="button">להתחיל מחדש</button>
    </div>
  </div>
  <p class="notice" style="margin-top: var(--s6)">השאלון מכוון בלבד. הוא לא קובע זכאות, וההחלטה נשארת אצל הגורמים המוסמכים.</p>
</Base>

<script>
  type Branch = { id: string; label: string; base: string[]; questions: { q: string; options: { label: string; add: string[] }[] }[] };
  const root = document.getElementById('app')!;
  const data = JSON.parse(root.dataset.payload!) as { branches: Branch[]; rights: Record<string, { title: string; summary: string; url: string }>; contacts: string; rightsList: string; logo: string; banks: string; docs: string };
  const title = document.getElementById('step-title')!;
  const box = document.getElementById('options')!;
  const restart = document.getElementById('quiz-nav')!;
  const restartBtn = document.getElementById('restart')!;
  const backBtn = document.getElementById('back-step')!;
  const progress = document.getElementById('quiz-progress')!;
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);

  const row = (label: string, attr: string) => `<button class="row" type="button" ${attr}><span class="tx"><span class="t">${esc(label)}</span></span></button>`;

  function start() {
    title.textContent = 'מה הקושי העיקרי שלך?';
    box.className = 'group';
    box.innerHTML = data.branches.map((b) => row(b.label, `data-branch="${b.id}"`)).join('');
    restart.hidden = true;
    progress.hidden = true;
  }
  const focusTitle = () => { title.focus({ preventScroll: true }); scrollTo({ top: 0 }); };

  function ask(b: Branch, i: number, picked: string[]) {
    if (i >= b.questions.length) return result(b, picked);
    const q = b.questions[i];
    title.textContent = q.q;
    progress.textContent = `שאלה ${i + 1} מתוך ${b.questions.length}`;
    progress.hidden = false;
    box.innerHTML = q.options.map((o, k) => row(o.label, `data-k="${k}"`)).join('');
    restart.hidden = false;
    box.onclick = (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-k]');
      if (!btn) return;
      const next = [...picked, ...q.options[+btn.dataset.k!].add];
      history.pushState({ b: b.id, i: i + 1, picked: next }, '');
      ask(b, i + 1, next);
      focusTitle();
    };
  }

  function result(b: Branch, picked: string[]) {
    const ids = [...new Set([...b.base, ...picked])].filter((id) => data.rights[id]);
    box.className = '';
    progress.hidden = true;
    const items = ids.map((id) => `<a class="row" href="${data.rights[id].url}"><span class="tx"><span class="t">${esc(data.rights[id].title)}</span><span class="s">${esc(data.rights[id].summary)}</span></span></a>`).join('');
    const docs = b.id === 'docs' ? `<div class="group" style="margin-bottom: var(--s4)"><a class="row" href="${data.banks}"><span class="tx"><span class="t">הוצאת אישורים מהבנק</span></span></a><a class="row" href="${data.docs}"><span class="tx"><span class="t">מסמכים כלכליים: מה זה ואיך מפיקים</span></span></a></div>` : '';
    // ענף שלא מוביל לאף זכות (למשל "נושא אחר"): לא מציגים "כדאי לבדוק:" מעל רשימה ריקה
    const empty = !items && !docs;
    title.textContent = empty ? 'כדאי לדבר עם מש״קית הת״ש' : 'כדאי לבדוק:';
    const next = empty
      ? `<p style="margin-top: 0">אפשר גם לעבור על רשימת הזכויות המלאה.</p>
      <a class="btn purple block" href="${data.contacts}">למש״קית הת״ש שלי</a>
      <a class="btn ghost block" style="margin-top: var(--s2)" href="${data.rightsList}">לכל הזכויות</a>`
      : `<strong>הצעד הבא</strong><p>כדאי לדבר עם מש״קית הת״ש ולהכין את המסמכים שמופיעים בכל עמוד.</p>
      <a class="btn purple block" href="${data.contacts}">למש״קית הת״ש שלי</a>`;
    box.innerHTML = `${docs}${items ? `<div class="group">${items}</div>` : ''}
      <div class="card-soft" style="margin-top: ${empty ? '0' : 'var(--s5)'}">${next}
      <a class="tash-row" style="margin-top: var(--s3)" href="https://tash.digital.idf.il/landing/" target="_blank" rel="noopener"><img class="tb-logo" src="${data.logo}" alt="" width="44" height="44" decoding="async" /><span class="tb-tx"><strong>ת״ש בטאצ׳</strong><span>בקשות ומעקב במערכת הדיגיטלית</span></span></a></div>`;
    restart.hidden = false;
  }

  box.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-branch]');
    if (!btn) return;
    const b = data.branches.find((x) => x.id === btn.dataset.branch)!;
    history.pushState({ b: b.id, i: 0, picked: [] }, '');
    ask(b, 0, []);
    focusTitle();
  });
  // מצב השאלון נשמר בהיסטוריה: כפתור החזרה חוזר שאלה אחת, ורענון ממשיך מאותו שלב
  const restore = (st: { b?: string; i?: number; picked?: string[] } | null) => {
    const b = st && data.branches.find((x) => x.id === st.b);
    if (st && b) ask(b, st.i ?? 0, st.picked ?? []);
    else start();
  };
  addEventListener('popstate', (e) => restore(e.state));
  restartBtn.addEventListener('click', () => { history.pushState({ root: 1 }, ''); start(); });
  backBtn.addEventListener('click', () => history.back());
  restore(history.state);
</script>

<style>
  .quiz-nav { display: flex; gap: var(--s2); margin-top: var(--s4); }
  .quiz-nav .btn { flex: 1; min-height: 48px; padding-inline: var(--s3); font-size: 15px; }
  #step-title { min-height: 2.6em; }
  .quiz-progress { margin: 0 0 calc(var(--s2) * -1); color: var(--purple); font: 700 14px/1.4 var(--display); }
  .quiz-progress[hidden] { display: none; }
  .quiz-progress + #step-title { margin-top: var(--s3); }
</style>
